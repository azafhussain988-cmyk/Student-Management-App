{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web - Chrome Fixed Port",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port",
        "7357"
